# Supabase (public values only — never put the service-role key here)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Set to true only after applying supabase/migrations (see supabase/README.md)
VITE_PLATFORM_DB_READY=false
# Optional client accounts/portal (requires VITE_PLATFORM_DB_READY=true)
VITE_ENABLE_CLIENT_PORTAL=false
# Optional AI reflections in Imela Persona (requires the persona-respond Edge Function + provider secrets)
VITE_PERSONA_AI_ENABLED=false
# Anonymous counselling portal (Persona ID + recovery secret).
# Requires migration 0007 and the persona-register / persona-account Edge Functions.
VITE_PERSONA_PORTAL_ENABLED=false
# Synthetic login domain for Persona logins; must equal PERSONA_LOGIN_DOMAIN in the Edge Functions.
VITE_PERSONA_LOGIN_DOMAIN=persona.imelaventures.invalid
